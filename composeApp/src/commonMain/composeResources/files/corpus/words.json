  { "id": "satz-plaene", "text": "Die Pläne lagen lange im Amt.", "language": "de-DE", "syllableCount": 9, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-freund", "text": "Sein alter Freund kommt gerade vorbei.", "language": "de-DE", "syllableCount": 9, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-schlamm", "text": "Er liegt im Schlamm vor dem Haus.", "language": "de-DE", "syllableCount": 8, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-warten", "text": "Sie warten beide auf den Chef.", "language": "de-DE", "syllableCount": 8, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-schiff", "text": "Am Himmel taucht plötzlich ein Schiff auf.", "language": "de-DE", "syllableCount": 9, "category": "EVERYDAY", "kind": "SENTENCE" },
