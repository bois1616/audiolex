  { "id": "satz-kuchen", "text": "Am Sonntag backen wir zusammen einen großen Kuchen.", "language": "de-DE", "syllableCount": 15, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-garten", "text": "Die Kinder spielen im Garten mit einem bunten Ball.", "language": "de-DE", "syllableCount": 14, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-sonne", "text": "Nach dem Regen scheint endlich wieder die warme Sonne.", "language": "de-DE", "syllableCount": 14, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-fahrrad", "text": "Mein Bruder fährt jeden Morgen mit dem Fahrrad zur Arbeit.", "language": "de-DE", "syllableCount": 15, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-blumen", "text": "Auf dem Tisch steht eine Vase mit frischen Blumen.", "language": "de-DE", "syllableCount": 13, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-zeitung", "text": "Der alte Mann liest jeden Abend eine spannende Zeitung.", "language": "de-DE", "syllableCount": 16, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-schlitten", "text": "Im Winter fahren die Kinder gerne mit dem Schlitten.", "language": "de-DE", "syllableCount": 14, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-katze", "text": "Unsere Katze schläft am liebsten auf dem warmen Sofa.", "language": "de-DE", "syllableCount": 15, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-fruehstueck", "text": "Zum Frühstück gibt es heute Brötchen mit Honig und Käse.", "language": "de-DE", "syllableCount": 15, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-zug", "text": "Der Zug nach Hamburg hat heute leider zwanzig Minuten Verspätung.", "language": "de-DE", "syllableCount": 18, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-erster-text", "text": "Dies ist mein erster Text.", "language": "de-DE", "syllableCount": 6, "category": "EVERYDAY", "kind": "SENTENCE" },
