  { "id": "satz-en-kettle", "text": "The kettle is boiling in the kitchen.", "language": "en-US", "syllableCount": 10, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-en-fence", "text": "My neighbor paints his fence dark green.", "language": "en-US", "syllableCount": 8, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-en-umbrella", "text": "She forgot her umbrella on the train.", "language": "en-US", "syllableCount": 10, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-en-bread", "text": "The bread smells better than it tastes.", "language": "en-US", "syllableCount": 8, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-en-cows", "text": "Two cows are standing in the rain.", "language": "en-US", "syllableCount": 8, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-en-envelope", "text": "He writes the address on an envelope.", "language": "en-US", "syllableCount": 10, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-en-lighthouse", "text": "The lighthouse blinks twice every minute.", "language": "en-US", "syllableCount": 9, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-en-thunder", "text": "Thunder woke the whole street last night.", "language": "en-US", "syllableCount": 8, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-en-strawberries", "text": "We picked strawberries until the basket was full.", "language": "en-US", "syllableCount": 12, "category": "EVERYDAY", "kind": "SENTENCE" },
