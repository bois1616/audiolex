  { "id": "satz-morgen", "text": "Am Morgen steht ein Bagger vor dem Haus.", "language": "de-DE", "syllableCount": 10, "category": "EVERYDAY", "kind": "SENTENCE" },
  { "id": "satz-bademantel", "text": "Ein Mann im Bademantel kommt aus dem Haus.", "language": "de-DE", "syllableCount": 11, "category": "EVERYDAY", "kind": "SENTENCE" },
