# Gradle
.gradle/
build/
local.properties

# Kotlin / IDE
.kotlin/
.idea/
*.iml
captures/
.cxx/

# Umgebung / Secrets
.env
.envrc

# Audiodaten (Versionierungsstrategie offen, siehe Backlog [PROP] Git-LFS)
composeApp/src/commonMain/composeResources/files/corpus/**/*.wav
composeApp/src/commonMain/composeResources/files/corpus/**/*.mp3
composeApp/src/commonMain/composeResources/files/corpus/**/*.ogg
# Störgeräusch-Loops (gebündelte Compose-Ressourcen, aus resources/sounds konvertiert)
composeApp/src/commonMain/composeResources/files/noise/*.wav
composeApp/src/commonMain/composeResources/files/noise/*.mp3
composeApp/src/commonMain/composeResources/files/noise/*.ogg
# Autor-Quellbibliothek: Rohaufnahmen/-geräusche (Störgeräusche jetzt, eigene Wort-/Satzaufnahmen später)
resources/sounds/*.mp3
resources/sounds/*.wav
resources/sounds/*.ogg
resources/sounds/*.m4a
resources/sounds/*.flac
# Ausnahme: core/src/jvmTest/resources/*.wav ist eine winzige, bewusst
# eingecheckte Loader-Testfixture, kein Korpus-Inhalt.
!core/src/jvmTest/resources/*.wav

# Python-Tooling (tools/, TTS-Generierung u.ä.)
__pycache__/
*.py[oc]
.venv/

# TTS-Stimmodelle (großer Download, per Skript reproduzierbar, siehe tools/generate_tts.py)
tools/voices/
